<?xml version="1.0" encoding="utf-8"?>
<!-- Az első sor élő visszaszámlálása: a Chronometer magától jár, a widgetet
     nem kell hozzá frissíteni. A színe erőforrásból jön (nappali/éjszakai
     változat), mert a kódból állított szín nem követi a módváltást. -->
<Chronometer xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/countdown"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:countDown="true"
    android:gravity="end"
    android:maxLines="1"
    android:textColor="@color/widget_countdown"
    android:textSize="14sp"
    android:textStyle="bold" />
